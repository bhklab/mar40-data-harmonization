# MAR-40 | Snakemake entry point for reproducible cohort visualization
# Run from repository root:
#   snakemake --snakefile workflow/Snakefile --cores 1 --dry-run
#   snakemake --snakefile workflow/Snakefile --cores 1
# Existing harmonization/QC workflows can later be connected as upstream rules.

configfile: "config/visualization.yaml"

DATASETS = sorted(config["datasets"])
if not DATASETS:
    raise ValueError("No visualization datasets configured.")

include: "rules/visualization.smk"

rule all:
    input:
        expand(
            "results/visualization/{dataset}/{filename}",
            dataset=DATASETS,
            filename=VISUALIZATION_FILES,
        )
